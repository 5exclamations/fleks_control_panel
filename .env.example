# Copy to .env (repository root or DjangoProject1/.env) for local development.
# .env is gitignored. In production (Render) set these under Service -> Environment instead.

# PostgreSQL connection string, e.g. the Neon connection string from the Neon dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Django secret key (any long random string for local development)
SECRET_KEY=replace-with-a-long-random-string

# Optional. Defaults: DEBUG=True, ALLOWED_HOSTS=fleks-control-panel.onrender.com,127.0.0.1,localhost
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
